# AGIA — Variables de entorno
# Copiar este archivo como .env y completar los valores

# ── Inteligencia Artificial ──────────────────────────────
# Clave de la API de Google Gemini (gratuita para empezar)
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# ── Base de datos (Supabase) ─────────────────────────────
# Crear cuenta gratuita en: https://supabase.com
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave_de_supabase_aqui

# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Seguridad ────────────────────────────────────────────
# Orígenes permitidos para peticiones (separados por coma)
ORIGENES_PERMITIDOS=http://localhost:3000,https://tu-app.com

# ── Notificaciones (para más adelante) ──────────────────
# Twilio para SMS de respaldo
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMERO=
